# Supply through the process environment or Node --env-file; never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
CLEC_WORKSPACE=..
CLEC_STATE_DIR=.data
CLEC_QMD_URL=http://localhost:8181
CLEC_DEADLINE_MS=600000
CLEC_PORT=3000
# Optional; default is CLEC_STATE_DIR/pi. Actual Pi session files, not credentials.
# CLEC_PI_DIR=/absolute/derived-state/pi
# Cumulative UTF-8 context bytes +2048 output reserve/request; not exact token count.
CLEC_MODEL_ADMISSION_UNITS=240000
# Optional for HYBRID builds: select before building and use same value for QMD serving.
# QMD_EMBED_MODEL=hf:Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf
