    "payloads/"
  ],
  "scripts": {
    "postinstall": "node scripts/install.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Centurybbx/clec-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Centurybbx/clec-cli/issues"
  },
