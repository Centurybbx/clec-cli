{
  "name": "@clec/cli",
  "version": "1.0.0-dev.0",
  "description": "Offline CLEC evidence search, exact byte-span reads, and static snapshot sync",
  "type": "module",
  "bin": {
    "clec": "bin/clec.exe"
  },
  "files": [
    "bin/clec.exe",
    "scripts/install.mjs",
    "scripts/targets.mjs",
    "skills/clec/SKILL.md",
