{
  "name": "@clec/cli",
  "version": "0.2.0",
  "description": "Offline CLEC evidence search and exact source reads",
  "type": "module",
  "bin": {
    "clec": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/*.js",
    "docs/agent-guide.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:corpus": "node dist/publisher.js",
    "prepare": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "opencc-js": "1.0.5"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Centurybbx/clec-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Centurybbx/clec-cli/issues"
  },
  "homepage": "https://github.com/Centurybbx/clec-cli#readme"
}
